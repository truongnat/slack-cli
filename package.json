{
  "name": "slack-cli",
  "version": "1.0.0",
  "description": "Automate Slack using your existing Chrome login session",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "slack-cli": "./bin/slack-cli.js"
  },
  "scripts": {
    "start": "node ./bin/slack-cli.js",
    "setup": "node ./bin/slack-cli.js setup",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "playwright": "^1.64.1"
  },
  "keywords": [
    "slack",
    "cli",
    "playwright",
    "chrome",
    "automation"
  ],
  "license": "MIT",
  "private": true
}
